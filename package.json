{
    "name": "nestcrow",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20 <27"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "prepare": "husky",
        "lint": "next lint",
        "lint:all": "eslint . && prettier --check .",
        "lint:fix": "eslint --fix . && prettier --write .",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#target\" \"#dist\"",
        "lint:rust": "cargo lint",
        "lint:rust:fmt": "cargo fmt --all -- --check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test-anchor": "TS_NODE_PROJECT=./tsconfig.tests.json node ./node_modules/mocha/bin/mocha.js"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,yaml,yml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@coral-xyz/anchor": "^0.31.1",
        "@elevenlabs/client": "^1.9.0",
        "@elevenlabs/react": "^1.6.4",
        "@google-cloud/secret-manager": "^6.1.2",
        "@google/generative-ai": "^0.24.1",
        "@hookform/resolvers": "^3.9.0",
        "@radix-ui/react-alert-dialog": "^1.1.1",
        "@radix-ui/react-avatar": "^1.1.0",
        "@radix-ui/react-dialog": "^1.1.1",
        "@radix-ui/react-dropdown-menu": "^2.1.1",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-progress": "^1.1.0",
        "@radix-ui/react-select": "^2.1.0",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slider": "^1.2.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-tabs": "^1.1.0",
        "@radix-ui/react-toast": "^1.2.1",
        "@rainbow-me/rainbowkit": "^2.2.11",
        "@solana/spl-token": "^0.4.14",
        "@solana/wallet-adapter-base": "^0.9.23",
        "@solana/wallet-adapter-react": "^0.15.35",
        "@solana/wallet-adapter-react-ui": "^0.9.35",
        "@solana/wallet-adapter-wallets": "^0.19.32",
        "@solana/web3.js": "^1.98.0",
        "@tanstack/react-query": "^5.51.1",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "firebase": "^12.14.0",
        "firebase-admin": "^13.10.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^1.17.0",
        "next": "14.2.35",
        "pdfjs-dist": "^4.4.168",
        "react": "^18",
        "react-dom": "^18",
        "react-dropzone": "^14.2.3",
        "react-hook-form": "^7.52.1",
        "tailwind-merge": "^2.4.0",
        "tailwindcss-animate": "^1.0.7",
        "viem": "^2.51.3",
        "wagmi": "^2.19.5",
        "zod": "^3.23.8",
        "zustand": "^4.5.4"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.0",
        "@commitlint/types": "^19.8.0",
        "@types/bn.js": "^5.1.6",
        "@types/chai": "^4.3.20",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.15.0",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.0.1",
        "bn.js": "^5.2.1",
        "chai": "^4.5.0",
        "eslint": "^9.28.0",
        "eslint-config-next": "^16.2.6",
        "eslint-config-prettier": "^10.1.5",
        "husky": "^9.1.7",
        "lint-staged": "^14.0.0",
        "markdownlint-cli2": "^0.22.1",
        "mocha": "^10.8.2",
        "postcss": "^8",
        "prettier": "^3.5.3",
        "tailwindcss": "^3.4.1",
        "ts-mocha": "^10.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@vitejs/plugin-react": "^4.5.2",
        "@vitest/ui": "^3.2.0",
        "jsdom": "^26.1.0",
        "vitest": "^3.2.0"
    }
}
