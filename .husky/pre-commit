#!/bin/sh
# Merge commits often include upstream files that are not yet lint-clean.
if [ -f .git/MERGE_HEAD ]; then
  exit 0
fi

# Full-app typecheck omitted until existing app code satisfies the stricter
# root tsconfig (exactOptionalPropertyTypes, noPropertyAccessFromIndexSignature).
yarn lint-staged

# If any .rs files are staged, check Rust formatting
if git diff --cached --name-only | grep -q '\.rs$'; then
  cargo fmt --all -- --check
fi
