# =============================================================================
#  NestCrow .gitignore
#  Covers: Anchor/Rust program, Next.js/React + TypeScript frontend, Firebase,
#  and the usual editor and OS clutter.
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS AND KEYS  -  never commit these
# -----------------------------------------------------------------------------
# Environment files (Gemini API key, Firebase config, RPC URLs, etc.)
.env
.env.*
!.env.example

# Solana keypairs. Anyone with this file controls the wallet.
*.json.key
id.json
keypair.json
*-keypair.json
wallet.json

# Firebase service account credentials (if you ever download one)
serviceAccountKey.json
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# -----------------------------------------------------------------------------
# NODE / NEXT.JS / TYPESCRIPT
# -----------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnp.*

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage
coverage/
.nyc_output/
tests/firestore-rules/node_modules/

# -----------------------------------------------------------------------------
# ANCHOR / RUST / SOLANA
# -----------------------------------------------------------------------------
# Rust build output for the on-chain program
target/
**/*.rs.bk
Cargo.lock

# Anchor build artifacts
.anchor/
test-ledger/

# Note: keep Anchor.toml and program source committed. They are not artifacts.

# -----------------------------------------------------------------------------
# FIREBASE
# -----------------------------------------------------------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Keep firebase.json, .firebaserc, firestore.rules and storage.rules committed.

# -----------------------------------------------------------------------------
# EDITORS AND OS
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim, Emacs
*.swp
*.swo
*~

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------
# Vercel deploy cache (if you deploy the frontend there)
.vercel/

# AI assistant and tool local directories
.serena/
.sixth/
.agents/
.claude/
skills-lock.json

# Base44 CLI local cache
base44/

# Local-only notes that should not be public
NOTES.md
TODO.local.md

# Temporary files
.tmp/

# Accidental Husky mis-install (e.g. `husky --version` sets hooksPath to `--version/_`)
--version/

# Root uses Yarn; ignore only the root npm lockfile. Cloud Run services
# under services/* are standalone npm packages and keep their own lockfiles.
/package-lock.json
.vercel

# Service account keys — never commit
.sa-keys/
sa-keys/
*.json.key
firebase-adminsdk*.json
