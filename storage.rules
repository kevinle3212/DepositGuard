rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── contracts/{leaseId}/{filename} ───────────────────────────────────────
    // PDF uploads; write-once (no update/delete).
    match /contracts/{leaseId}/{filename} {
      allow read: if true;
      allow create: if request.resource.contentType == 'application/pdf'
          && request.resource.size <= 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ── photos/{phase}/{filename} ────────────────────────────────────────────
    // Move-in / move-out image uploads from PhotoVerification component.
    match /photos/{phase}/{filename} {
      allow read: if true;
      allow create: if request.resource.contentType.matches('image/.*')
          && request.resource.size <= 20 * 1024 * 1024;
      allow update, delete: if false;
    }

    // ── photos/{leaseId}/{phase}/{filename} ──────────────────────────────────
    // Scoped per-lease photo uploads (alternate path shape).
    match /photos/{leaseId}/{phase}/{filename} {
      allow read: if true;
      allow create: if request.resource.contentType.matches('image/.*')
          && request.resource.size <= 20 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
