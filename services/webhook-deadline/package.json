{
    "name": "@nestcrow/webhook-deadline",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "jest"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "transformIgnorePatterns": [
            "node_modules/(?!(rpc-websockets)/)"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.+)\\.js$": "$1"
        },
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "diagnostics": {
                        "ignoreCodes": [
                            7016
                        ]
                    }
                }
            ]
        }
    },
    "dependencies": {
        "@google-cloud/secret-manager": "^6.1.2",
        "@solana/web3.js": "^1.98.0",
        "bs58": "^4.0.1",
        "express": "^5.2.1",
        "firebase-admin": "^12.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bs58": "^4.0.4",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.0",
        "typescript": "^5.8.0"
    }
}
