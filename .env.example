# DepositGuard — local devnet (gitignored; never commit)
# Copy to .env and fill in secrets: cp .env.example .env

# ── GCP / Firebase ───────────────────────────────────────────────────────────
# console.cloud.google.com → select your project → Project ID from the top bar
GCP_PROJECT_ID=
# The GCP region where your Cloud Run services and Vertex AI are deployed (e.g. us-central1)
GCP_LOCATION=us-central1
# console.firebase.google.com → your project → Storage → default bucket name (format: <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── Solana devnet ────────────────────────────────────────────────────────────
# RPC endpoint — swap for Helius or QuickNode for higher rate limits
SOLANA_RPC_URL=https://api.devnet.solana.com
# Solana cluster name used for Solscan explorer links (devnet | mainnet-beta)
SOLANA_CLUSTER=devnet
# Program ID produced by `anchor build && anchor deploy` on devnet
NEST_CROW_PROGRAM_ID=

# ── Oracle / Relayer keypairs (SECRET) ───────────────────────────────────────
# The full oracle keypair encoded as base58. Generate with:
#   node -e "const n=require('@solana/web3.js'),b=require('bs58');const kp=n.Keypair.generate();console.log(b.encode(kp.secretKey))"
# Store the production value in Google Cloud Secret Manager, not here.
ORACLE_KEYPAIR_BASE58=
# Base58-encoded relayer keypair (takes priority over ORACLE_KEYPAIR_BASE58 when set)
RELAYER_KEYPAIR_BASE58=

# ── Auth / Signing ────────────────────────────────────────────────────────────
# 32-byte hex JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SIGNING_SECRET=
# Public base URL of the Next.js app (used to construct magic-link signing URLs)
APP_BASE_URL=https://nestcrow.tech

# ── SendGrid ─────────────────────────────────────────────────────────────────
# app.sendgrid.com → Settings → API Keys → Create API Key (Full Access) → copy the SG.* token
SENDGRID_API_KEY=
# Verified sender identity in SendGrid (Settings → Sender Authentication)
SENDGRID_FROM_EMAIL=noreply@nestcrow.tech

# ── Internal services ─────────────────────────────────────────────────────────
# Internal URL of the notify Cloud Run service (used by webhook-deadline to send emails)
NOTIFY_SERVICE_URL=http://localhost:8080
# Port for local service instances
PORT=8080

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# ElevenLabs agent platform guide ID (NEXT_PUBLIC_ prefix exposes it to the browser)
# elevenlabs.io → Conversational AI → your agent → Agent ID
NEXT_PUBLIC_ELEVEN_AGENT_PLATFORM_GUIDE=
