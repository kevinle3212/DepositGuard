# NestCrow — local devnet (gitignored; never commit)
# Copy to .env and fill in secrets: cp .env.example .env

# ── GCP / Firebase ───────────────────────────────────────────────────────────
# console.cloud.google.com → select your project → Project ID from the top bar
GOOGLE_CLOUD_PROJECT=
# console.cloud.google.com → select your project → Project Number from the project info card
GOOGLE_PROJECT_NUMBER=
# console.firebase.google.com → your project → Storage → default bucket name (format: <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# The GCP region where your Cloud Run services are deployed (e.g. us-central1)
GCP_REGION=
# The region used for Vertex AI / Gemini calls — must support gemini-2.0-flash (e.g. us-central1)
VERTEX_LOCATION=

# ── Solana devnet ────────────────────────────────────────────────────────────
# Public devnet RPC endpoint (NEXT_PUBLIC_ prefix required for browser access) — swap for Helius or QuickNode for higher rate limits
NEXT_PUBLIC_SOLANA_RPC_URL=
# Program ID produced by `anchor build && anchor deploy` on devnet
NEST_CROW_PROGRAM_ID=
# Devnet USDC SPL token mint address
DEVNET_USDC_MINT=

# ── Demo wallets (Phantom pubkeys) ───────────────────────────────────────────
# Phantom → copy the public key at the top of the wallet (landlord account)
LANDLORD_WALLET=
# Phantom → copy the public key at the top of the wallet (tenant account)
TENANT_WALLET=

# ── Oracle keypair (SECRET) ───────────────────────────────────────────────────
# The oracle's Ed25519 public key (base58). Generate a new keypair with:
#   node -e "const n=require('@solana/web3.js');const kp=n.Keypair.generate();console.log(kp.publicKey.toBase58())"
ORACLE_PUBLIC_KEY=
# The full oracle keypair encoded as base58. Generate with:
#   node -e "const n=require('@solana/web3.js'),b=require('bs58');const kp=n.Keypair.generate();console.log(b.encode(kp.secretKey))"
# Store the production value in Google Cloud Secret Manager, not here.
ORACLE_KEYPAIR_BASE58=

# ── Local services ───────────────────────────────────────────────────────────
PORT=

# ── SendGrid ─────────────────────────────────────────────────────────────────
# app.sendgrid.com → Settings → API Keys → Create API Key (Full Access) → copy the SG.* token
SENDGRID_API_KEY=
# Verified sender identity in SendGrid (Settings → Sender Authentication)
SENDGRID_FROM_EMAIL=noreply@nestcrow.tech
# Internal URL of the notify Cloud Run service (used by webhook-deadline to send emails)
NOTIFY_SERVICE_URL=http://localhost:8080

# ── Twilio ────────────────────────────────────────────────────────────────────
# console.twilio.com → Account → General Settings → Auth Token backup codes → copy one recovery code
TWILIO_RECOVERY_CODE=

# ── Section 9 — Contract upload and signing ──────────────────────────────────
# Base58-encoded relayer keypair — generate with:
#   node -e "const n=require('@solana/web3.js'),b=require('bs58');const kp=n.Keypair.generate();console.log(b.encode(kp.secretKey))"
RELAYER_KEYPAIR_BASE58=
# 32-byte hex JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SIGNING_SECRET=
# Public base URL of the Next.js app (used to construct magic-link signing URLs)
APP_BASE_URL=https://nestcrow.tech

# ── Future ───────────────────────────────────────────────────────────────────
# elevenlabs.io → Profile → API Keys → copy your secret key
# ELEVENLABS_API_KEY=
